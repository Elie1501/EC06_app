# ============================================================
#  Fichier d'exemple des variables d'environnement.
#  Copiez-le en .env :  cp .env.dist .env
#
#  Le .env réel est IGNORÉ par Git (voir .gitignore) et NE DOIT
#  JAMAIS contenir de secrets versionnés. Les valeurs ci-dessous
#  sont des PLACEHOLDERS destinés au développement local et à la CI.
# ============================================================

# --- Application ---
PORT=3000
NODE_ENV=development

# --- Base de données PostgreSQL (service "db" du docker-compose) ---
POSTGRES_USER=skillhub
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=skillhub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL de connexion dérivée (host = nom du service compose)
DATABASE_URL=postgres://skillhub:change-me-local-only@db:5432/skillhub
